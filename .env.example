# Overrides for docker-compose.yml (local development). Copy to .env (git-ignored) and edit.
# Every value has a working default; change them if the machine is shared or reachable by others.

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Generate with: openssl rand -base64 48
JWT_SECRET=dev-insecure-change-me-please-0123456789

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Comma-separated Google OAuth client IDs (web first); empty disables Google sign-in.
GOOGLE_CLIENT_IDS=

# Host interfaces the published ports bind to. Keep 127.0.0.1: Mailpit shows password-reset
# links and Postgres uses the credentials above. Use 0.0.0.0 only on a trusted network.
API_BIND=127.0.0.1
POSTGRES_BIND=127.0.0.1
MAILPIT_BIND=127.0.0.1
