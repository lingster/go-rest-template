# Base URL of the Go/Beego REST API (no trailing slash, no /api/v1 suffix).
# Must also be set at BUILD time: it is used to generate the CSP connect-src.
PUBLIC_API_URL=http://localhost:8080

# Sign in with Google (see the root README, "Google sign-in setup"). Build-time switch that adds the Google
# Identity Services origins to the CSP. Set to true together with GOOGLE_CLIENT_IDS on the API; the button
# itself appears only when GET /auth/providers reports google.enabled.
PUBLIC_GOOGLE_SIGNIN=false
