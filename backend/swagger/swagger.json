    "definitions": {
        "dto.AdminUpdateUserRequest": {
            "title": "AdminUpdateUserRequest",
            "type": "object",
            "properties": {
                "email_verified": {
                    "type": "boolean"
                },
                "is_active": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "role": {
                    "description": "user or admin",
                    "type": "string"
                }
            }
        },
        "dto.AuditLog": {
            "title": "AuditLog",
            "type": "object",
            "properties": {
                "action": {
                    "type": "string",
                    "example": "login.success"
                },
                "actor_id": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "ip": {
                    "type": "string"
                },
                "metadata": {
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "user_agent": {
                    "type": "string"
                },
                "user_id": {
                    "type": "string"
                }
            }
        },
        "dto.AuditLogPage": {
            "title": "AuditLogPage",
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.AuditLog"
                    }
                },
                "page": {
                    "type": "integer",
                    "format": "int64"
                },
                "per_page": {
                    "type": "integer",
                    "format": "int64"
                },
                "total": {
                    "type": "integer",
                    "format": "int64"
                }
            }
        },
