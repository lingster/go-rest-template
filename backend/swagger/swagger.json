{
    "swagger": "2.0",
    "info": {
        "title": "Go REST Template API",
        "description": "JSON API for the SaaS starter template: auth (JWT + rotating refresh tokens), TOTP 2FA, WebAuthn passkeys, profile and admin endpoints. Errors use the envelope {\"error\":{\"code\",\"message\",\"details\"}}. Health check: GET /healthz.\n",
        "version": "1.0.0",
        "contact": {
            "email": "ling@aidraw.ai"
        },
        "license": {
            "name": "MIT"
        }
    },
    "basePath": "/api/v1",
    "paths": {
