                        }
                    },
                    "401": {
                        "description": "invalid_token or token_expired"
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "tags": [
                    "auth"
                ],
                "description": "Create a new account. Sends a verification email.\n\u003cbr\u003e",
                "operationId": "AuthController.Register",
