                    "409": {
                        "description": "conflict: email already registered"
                    },
                    "422": {
                        "description": "validation_error"
                    },
                    "429": {
                        "description": "rate_limited"
                    }
                }
            }
        },
        "/auth/resend-verification": {
            "post": {
                "tags": [
                    "auth"
