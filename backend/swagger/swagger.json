                        }
                    }
                }
            }
        },
        "/auth/google": {
            "post": {
                "tags": [
                    "auth"
                ],
                "description": "Verifies a Google ID token server-side. Creates the account, or links it to an existing account with the same Google-verified email. Returns an AuthResponse, or an MfaChallenge (mfa_required=true) when TOTP is enabled: Google never bypasses 2FA. Disabled (404 google_signin_disabled) unless GOOGLE_CLIENT_IDS is set.\n\u003cbr\u003e",
                "operationId": "AuthController.LoginGoogle",
                "parameters": [
                    {
                        "in": "body",
                        "name": "body",
                        "description": "Google ID token",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.GoogleLoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "schema": {
                            "$ref": "#/definitions/dto.AuthResponse"
                        }
                    },
                    "401": {
                        "description": "invalid_token"
                    },
                    "403": {
                        "description": "account_disabled"
                    },
                    "404": {
                        "description": "google_signin_disabled"
                    },
                    "429": {
                        "description": "rate_limited"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "tags": [
                    "auth"
                ],
                "description": "Returns an AuthResponse, or an MfaChallenge (mfa_required=true) when 2FA is enabled.\n\u003cbr\u003e",
                "operationId": "AuthController.Login",
                "parameters": [
                    {
                        "in": "body",
                        "name": "body",
                        "description": "Credentials",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "schema": {
                            "$ref": "#/definitions/dto.AuthResponse"
                        }
                    },
                    "401": {
                        "description": "invalid_credentials"
                    },
                    "403": {
                        "description": "email_not_verified or account_disabled"
                    },
                    "429": {
                        "description": "rate_limited"
                    }
                }
            }
        },
        "/auth/login/2fa": {
            "post": {
                "tags": [
                    "auth"
                ],
                "description": "Exchange the mfa_token plus a TOTP or recovery code for a session.\n\u003cbr\u003e",
                "operationId": "AuthController.LoginMFA",
                "parameters": [
                    {
                        "in": "body",
                        "name": "body",
                        "description": "MFA token and code",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.MFALoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "schema": {
                            "$ref": "#/definitions/dto.AuthResponse"
                        }
                    },
                    "401": {
                        "description": "invalid_mfa_code, invalid_token or token_expired"
                    }
                }
            }
        },
