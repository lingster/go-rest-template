# Copy to .env and export (e.g. `set -a; source .env; set +a`) before `make run`.
APP_ENV=dev
HTTP_PORT=8080

# sqlite | postgres
DB_DRIVER=sqlite
# sqlite: file:data/app.db   postgres: postgres://app:app@localhost:5432/app?sslmode=disable
DATABASE_URL=file:data/app.db

# MUST be changed in prod (>= 32 chars); the server refuses to start in prod with the default.
JWT_SECRET=dev-insecure-change-me-please-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Adding a passkey / setting up TOTP requires a sign-in at most this old (refresh does not renew it).
REAUTH_MAX_AGE=10m
REQUIRE_EMAIL_VERIFICATION=true

# Sign in with Google: comma-separated OAuth client IDs accepted as the ID token audience
# (web, iOS, Android). The FIRST one must be the web client ID (advertised to clients).
# Leave empty to disable (POST /auth/google then returns 404 google_signin_disabled). See README.
GOOGLE_CLIENT_IDS=

# console (logs emails, incl. links) | smtp
MAIL_DRIVER=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# Refuse plaintext delivery when STARTTLS is unavailable (defaults to true when APP_ENV=prod).
SMTP_REQUIRE_TLS=false
MAIL_FROM=App <no-reply@example.com>

# Serve the API spec and Swagger UI at /swagger/ (defaults to true, but to false when APP_ENV=prod).
SWAGGER_ENABLED=true

FRONTEND_URL=http://localhost:5173
# Browser origins (comma list). Listed origins may use the webapp refresh cookie; * is refused when APP_ENV=prod.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Webapp refresh cookie: Secure + __Secure-rt name (defaults to true when APP_ENV=prod; false for plain-HTTP dev).
COOKIE_SECURE=false
# Cookie Domain; empty = host-only. Webapp and API must be same-site (app.example.com + api.example.com).
COOKIE_DOMAIN=

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Go REST Template
WEBAUTHN_RP_ORIGINS=http://localhost:5173

# Seeded (verified, role=admin) on first start when set and not existing. In prod the example value or
# anything shorter than 12 characters is refused; unset it once the admin exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Extras (not in the shared contract)
RATE_LIMIT_PER_MINUTE=60   # per IP on /api/v1/auth/*, 0 disables
BCRYPT_COST=12
TRUST_PROXY=false          # true only behind ONE trusted reverse proxy (uses the last X-Forwarded-For entry)

# Cover desk
SCHOOL_TIMEZONE=Europe/London     # IANA zone of the school day (booking dates, periods, ETA window)
AGENCY_RATE_LIMIT_PER_MINUTE=120  # per agency API key on /api/v1/agency/*, 0 disables
