# Copy to .env and export (e.g. `set -a; source .env; set +a`) before `make run`.
APP_ENV=dev
HTTP_PORT=8080

# sqlite | postgres
DB_DRIVER=sqlite
# sqlite: file:data/app.db   postgres: postgres://app:app@localhost:5432/app?sslmode=disable
DATABASE_URL=file:data/app.db

# MUST be changed in prod (>= 32 chars); the server refuses to start in prod with the default.
JWT_SECRET=dev-insecure-change-me-please-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REQUIRE_EMAIL_VERIFICATION=true

# console (logs emails, incl. links) | smtp
MAIL_DRIVER=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=App <no-reply@example.com>

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Go REST Template
WEBAUTHN_RP_ORIGINS=http://localhost:5173

# Seeded (verified, role=admin) on first start when set and not existing.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Extras (not in the shared contract)
RATE_LIMIT_PER_MINUTE=60   # per IP on /api/v1/auth/*, 0 disables
BCRYPT_COST=12
TRUST_PROXY=false          # true only behind a trusted reverse proxy (uses X-Forwarded-For)
